# Copy to .env for local development with `netlify dev`. On Netlify, add these under
# Site configuration -> Environment variables instead. NEVER commit a real .env file.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: model override (default is fast and cheap)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: require this code (entered in the app under Me -> Settings) before the AI endpoints work
# ACCESS_CODE=pick-a-secret-word
